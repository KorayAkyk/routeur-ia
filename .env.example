# Modèle de variables d'environnement. Ne jamais y écrire de vraie valeur dans le dépôt.
# Le service lit uniquement l'environnement : il ne charge aucun fichier .env tout seul.

# faux (par défaut, aucun appel réseau) ou reel
ROUTEUR_MODE=

# Clés des fournisseurs, utilisées seulement si ROUTEUR_MODE=reel
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Jeton d'accès au service, obligatoire pour écouter ailleurs que sur la machine locale
ROUTEUR_JETON_API=

# Chemins facultatifs
ROUTEUR_BASE=
ROUTEUR_CONFIG=
